# Supabase project Settings > API. Use the publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local: http://localhost:3000. Vercel: your stable https://YOUR-APP.vercel.app URL.
SITE_URL=http://localhost:3000
# Enable this provider in Supabase; provider secrets belong in Supabase, not here.
AUTH_PROVIDER=google
# Optional later, once email delivery and code templates are configured.
AUTH_EMAIL_ENABLED=false

# Server-only credentials. Never use NEXT_PUBLIC_ for these.
# Keep these values until the live launch is explicitly approved.
CHECKOUT_MODE=test
LIVE_PAYMENTS_ENABLED=false
# Existing test credentials continue to work without renaming.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional separate credentials let old test webhooks work after switching live.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=

# Legacy demo setup scripts. Orders now snapshot their fixed private bucket:
# test = lost-files-demo; live = lost-files-releases.
DOWNLOAD_BUCKET=lost-files-demo
# Optional purchase email delivery; keep disabled until a sender is verified.
PURCHASE_EMAIL_ENABLED=false
RESEND_API_KEY=
PURCHASE_EMAIL_FROM=
# Random server-only token for POST /api/jobs/purchase-emails (queued retries).
EMAIL_JOB_SECRET=
# Optional customer support contact on /recover.
SUPPORT_EMAIL=
