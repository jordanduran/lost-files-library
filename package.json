{
  "name": "archive-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:database": "node scripts/test-database.mjs",
    "test:auth": "node --conditions=react-server --experimental-strip-types scripts/test-auth-config.mjs",
    "test:session": "playwright test --config=playwright.auth.config.ts",
    "fixtures:audio": "node scripts/generate-demo-audio.mjs",
    "fixtures:catalog": "node --experimental-strip-types scripts/generate-catalog-seed.mjs",
    "format": "prettier --write .",
    "test:packs": "node scripts/test-pack-database.mjs && node --experimental-strip-types scripts/test-purchase-email.mjs && playwright test --config=playwright.pack.config.ts",
    "test:payments": "node --experimental-strip-types scripts/test-payment-modes.mjs",
    "test:payments:browser": "playwright test --config=playwright.payment-live.config.ts",
    "test:recovery": "node --experimental-strip-types scripts/test-purchase-recovery.mjs && playwright test --config=playwright.recovery.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "axe-core": "^4.13.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
